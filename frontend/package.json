{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002 --turbopack",
    "dev:webpack": "next dev -p 3002",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true}); console.log('.next cleaned');\"",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "build:clean": "npm run clean && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "start:local": "next start -p 3002",
    "vite:dev": "vite",
    "lint": "oxlint",
    "agentation:mcp": "npx -y agentation-mcp",
    "checkly:test": "checkly test",
    "checkly:deploy": "checkly deploy"
  },
  "dependencies": {
    "goey-toast": "^0.5.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "checkly": "^4.10.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
