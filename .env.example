# ==============================================================================
# KAVACH SECURITY CONTROL PLANE — ENVIRONMENT CONFIGURATION TEMPLATE
# Official Domain: kavachsecurity.me
# Copy this file to .env and configure real values before starting the platform.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application & Domain Settings
APP_NAME="Kavach Security Control Plane"
APP_ENV="development" # development | staging | production
APP_HOST="0.0.0.0"
APP_PORT=8000
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Official Domain & Frontend Endpoints
NEXT_PUBLIC_APP_URL="https://kavachsecurity.me"
NEXT_PUBLIC_API_URL=""

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET="change-this-insecure-default-to-a-random-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SuperAdmin & Founder Whitelist
FOUNDER_EMAIL="admin@kavachsecurity.me"

# Transactional Email & SMTP Configuration
# NOTE: Set real SMTP credentials in your hosting provider (Render / AWS / GCP)
# An alias (e.g. Google Workspace alias) requires valid SMTP authentication to deliver.
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME=""                        # Authenticated SMTP user (e.g. admin@kavachsecurity.me)
MAIL_PASSWORD=""                        # SMTP App Password (do NOT hardcode real password)
MAIL_DEFAULT_SENDER="noreply@kavachsecurity.me"  # Transactional sender address
MAIL_ALERTS_SENDER="alerts@kavachsecurity.me"    # Security notification sender
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Database Configuration (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_dev_password"
POSTGRES_DB="kavach_control_plane"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:secure_dev_password@localhost:5432/kavach_control_plane"
SQL_DATABASE_URL="sqlite+aiosqlite:///backend/dev.db"

# CORS Configuration (JSON array or comma-separated)
CORS_ORIGINS='["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173","https://kavachsecurity.me","https://app.kavachsecurity.me","https://api.kavachsecurity.me"]'

# Redis Cache & Background Tasks
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Policy Engine (Open Policy Agent)
OPA_URL="http://localhost:8181"
OPA_POLICY_PATH="policies/opa"

# Security Scanner Paths / Binaries
SEMGREP_BIN="semgrep"
GITLEAKS_BIN="gitleaks"
TRIVY_BIN="trivy"
OSV_BIN="osv-scanner"
CHECKOV_BIN="checkov"
SYFT_BIN="syft"

# LLM Reasoning Engine (Ollama / External API)
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3.2"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# GitHub OAuth Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3002/auth/callback/github"

# Google OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3002/auth/callback/google"
