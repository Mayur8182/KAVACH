# ==============================================================================
# SECURE CONTROL PLANE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the platform.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
APP_NAME="SecureAI Control Plane"
APP_ENV="development" # development | staging | production
APP_HOST="0.0.0.0"
APP_PORT=8000
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET="change-this-insecure-default-to-a-random-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_dev_password"
POSTGRES_DB="secure_control_plane"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:secure_dev_password@localhost:5432/secure_control_plane"

# Frontend Configuration
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]'
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Redis Cache & Background Tasks
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Policy Engine (Open Policy Agent)
OPA_URL="http://localhost:8181"
OPA_POLICY_PATH="policies/opa"

# Security Scanner Paths / Binaries
SEMGREP_BIN="semgrep"
GITLEAKS_BIN="gitleaks"
TRIVY_BIN="trivy"
OSV_BIN="osv-scanner"
CHECKOV_BIN="checkov"

# LLM Reasoning Engine (Ollama / External API)
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3.2"
