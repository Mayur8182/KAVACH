# =============================================================================
# KAVACH SECURITY PLATFORM — BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================

# Server settings
APP_NAME="Kavach Autonomous Security Platform"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
FRONTEND_URL="http://localhost:3002"
PUBLIC_APP_URL="http://localhost:3002"

# Database settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DB="kavach_security"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:your-postgres-password@localhost:5432/kavach_security"

# JWT Authentication
JWT_SECRET="generate-a-secure-random-32-char-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GitHub App Integration
GITHUB_APP_ID="5771182"
GITHUB_CLIENT_ID="Iv23liqai7qjzsE9RllD"
GITHUB_CLIENT_SECRET="your-github-app-client-secret"
GITHUB_APP_SLUG="kavach-security"
# Provide path to private key PEM or provide raw multiline PEM:
GITHUB_PRIVATE_KEY_PATH="certs/github-app-private-key.pem"
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET="your-configured-github-webhook-secret"
GITHUB_CALLBACK_URL="http://localhost:8000/integrations/github/callback"
GITHUB_WEBHOOK_URL="https://your-ngrok-domain.ngrok-free.app/webhooks/github"

# Legacy Personal Access Token (Optional fallback)
GITHUB_TOKEN=""

# Cal.com Scheduling Integration
CAL_API_KEY=""
CAL_EVENT_TYPE_ID=7917954
CAL_EVENT_SLUG="30min"

