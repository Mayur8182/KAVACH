{
  "name": "kavach-security",
  "displayName": "Kavach Security",
  "publisher": "kavach",
  "description": "Universal OAuth 2.1, automatic Git repository resolution, and MCP security scanning for VS Code, Cursor, and Windsurf",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Security",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Kavach Security",
      "properties": {
        "kavach.serverUrl": {
          "type": "string",
          "default": "https://mcp.kavachsecurity.me",
          "description": "Base URL of the Kavach MCP & OAuth 2.1 Security Gateway (e.g. https://mcp.kavachsecurity.me or http://localhost:8000)."
        },
        "kavach.autoResolveProject": {
          "type": "boolean",
          "default": true,
          "description": "Automatically resolve and activate the Kavach Cloud project matching the workspace Git remote on sign-in and startup."
        }
      }
    },
    "commands": [
      {
        "command": "kavach.signIn",
        "title": "Kavach: Sign In with OAuth 2.1"
      },
      {
        "command": "kavach.connectProject",
        "title": "Kavach: Connect / Auto-Detect Repository"
      },
      {
        "command": "kavach.switchProject",
        "title": "Kavach: Switch Active Project"
      },
      {
        "command": "kavach.configureMcp",
        "title": "Kavach: Configure MCP Server (.vscode/mcp.json)"
      },
      {
        "command": "kavach.scanWorkspace",
        "title": "Kavach: Run Security Scan via MCP"
      },
      {
        "command": "kavach.signOut",
        "title": "Kavach: Sign Out"
      }
    ]
  }
}
